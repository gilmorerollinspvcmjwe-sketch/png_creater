# Heya Studio Backend Configuration
# Copy this to .env and fill in your values

# LLM Provider Configuration
# Set MOCK_LLM=true to use mock mode (no API key required)
MOCK_LLM=true
LLM_PROVIDER=minimax

# MiniMax API Configuration
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=abab6.5s-chat
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Qwen API Configuration (fallback)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Redis Configuration (for session memory)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Supabase Configuration (for persistent storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here
SUPABASE_ENABLED=false

# Security Settings
MAX_COMPONENTS=12
MAX_IMAGES=8
MAX_TEXT_LENGTH=5000
MAX_CONFIG_SIZE_KB=100

# Rate Limits
RATE_LIMIT_GENERATE=10
RATE_LIMIT_CHAT=30
RATE_LIMIT_MODIFY=20

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Skills Directory
SKILLS_DIR=src/skills